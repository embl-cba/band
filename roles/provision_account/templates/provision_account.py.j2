def mk_homedir(username, path, uidNumber, gidNumber):
    # /home on the share is world-writable: never follow symlinks or chown a
    # tree someone else may have prepared, only the home directory itself
    path = decode_if_bytes(path)
    try:
        statinfo = os.lstat(path)
    except FileNotFoundError:
        print("create home %s" % path)
        if not DRY_RUN:
            os.mkdir(path, 0o700)
            os.lchown(path, uidNumber, gidNumber)
        return
    if not stat.S_ISDIR(statinfo.st_mode):
        raise Exception("users home directory is not a directory %s" % path)
    if statinfo.st_gid != gidNumber or statinfo.st_uid != uidNumber:
        print("fix owner of %s (was %d:%d)" % (path, statinfo.st_uid, statinfo.st_gid))
        if not DRY_RUN:
            fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            try:
                os.fchown(fd, uidNumber, gidNumber)
            finally:
                os.close(fd)

def mk_slurmaccount(acct):
    output = subprocess.check_output([SACCTMGR, "--noheader", "--parsable2", "list", "account", "format=account"]).decode('utf-8')
    if acct in output.split():
        return
    print("create slurm account %s" % acct)
    if not DRY_RUN:
        subprocess.check_call([SACCTMGR, "-i", "create", "account", acct])

def mk_slurmuser(userobj, acct):
    user = decode_if_bytes(userobj.entry['uid'][0])
    output = subprocess.check_output([SACCTMGR, "--noheader", "--parsable2", "list", "Association",
                                      "user=%s" % user, "format=account"]).decode('utf-8')
    if acct in [item.strip() for item in output.splitlines()]:
        return
    print("create slurm user %s in account %s" % (user, acct))
    if not DRY_RUN:
        subprocess.check_call([SACCTMGR, "-i", "create", "user", user, "account=%s" % acct, "DefaultAccount=%s" % acct])
        if SEND_EMAIL:
            send_email(userobj)

def mk_share_folders(username,uidNumber,gidNumber):
    """
    Make shared folders - data and workflow
    """
    path_data = "/home/public_share_data/"+username
    try:
        statinfo = os.stat(path_data)
    except OSError as e:
        if 'No such file or directory' in e:
            os.mkdir(path_data,int("0755",8))
    os.chown(path_data, uidNumber, gidNumber)


def decode_if_bytes(val):
    return val.decode('utf-8') if isinstance(val, bytes) else val

def send_email(user):
    fromaddr=MAIL_FROM
    ntoaddr=decode_if_bytes(user.entry.get('mail',[None])[0])
    fn=decode_if_bytes(user.entry.get('givenName',[b''])[0])
    sn=decode_if_bytes(user.entry.get('sn',[b''])[0])

    toaddr=ntoaddr
    #fn="Yi"
    #sn="Sun"
    msg= MIMEMultipart()
    msg['From']=fromaddr
    msg['To']=toaddr
#    msg['CC']="<admin address>"
    msg['Subject']="Your Account"

    body = ( "Dear "+ fn+" "+sn+"\n\n"
             "Your BAND Desktop account has been created.\n"
             "You can now launch desktops.\n\n"
             "Regards,\n"
             "EMBL CBBCS Team"
           )
    msg.attach(MIMEText(body,'plain'))

    server = smtplib.SMTP_SSL(SMTP_HOST,SMTP_PORT)
    if SMTP_USER:
        server.login(SMTP_USER, SMTP_PASSWORD)
    text= msg.as_string()
    server.sendmail(fromaddr, toaddr, text)
    server.quit()

