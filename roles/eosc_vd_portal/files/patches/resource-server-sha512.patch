+			// RSA/SHA-512 (RFC 8332): sshd on RHEL/Rocky 9 rejects SHA-1 ("ssh-rsa")
+			// CA signatures. The CA key itself stays type ssh-rsa (writeValue(RSAPublicKey)).
+			Signature signature = Signature.getInstance("SHA512withRSA", new BouncyCastleProvider());
 			signature.initSign(privKey);
 			signature.update(dataToSign);
-			writeValue("ssh-rsa", out1);
+			writeValue("rsa-sha2-512", out1);
