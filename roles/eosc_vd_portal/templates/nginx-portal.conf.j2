# Front end only; the reverse proxy terminates TLS for {{ eosc_portal_hostname }}
# and sends / here, /client and /guacamole to Tomcat (:8080) and /kc to eosc-rs
# (:{{ resource_server_port }}).
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    server_tokens off;

    # link to the front end in use (portal_frontend)
    root /var/www/html/portal;
    index index.html;

    # pages always fresh; assets/ have content hashes in their names
    location ~* \.html$ {
        add_header Cache-Control "no-cache";
    }
}
