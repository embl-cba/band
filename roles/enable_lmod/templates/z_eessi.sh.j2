# managed by ansible (BAND, role enable_lmod)
# EESSI {{ eessi_version }}; keep the prompt (the init prefixes it), then put
# our own modules first again
eessi_init=/cvmfs/software.eessi.io/versions/{{ eessi_version }}/init/bash
if [ -f "$eessi_init" ]; then
    ORIG_PS1="$PS1"
    source "$eessi_init" > /dev/null 2>&1
    export PS1="$ORIG_PS1"
    unset ORIG_PS1
    export MODULEPATH={{ lmod_modulepath | join(':') }}:$MODULEPATH
fi
unset eessi_init
