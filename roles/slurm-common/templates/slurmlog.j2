# SIGUSR2 makes slurmctld/slurmd reopen their log files
{% if slurmctrl == inventory_hostname %}
{{ slurmctlddebug.log }} {{ slurmschedlog.log }} {
    weekly
    rotate 8
    maxsize 200M
    compress
    delaycompress
    missingok
    notifempty
    sharedscripts
    create 0640 slurm slurm
    postrotate
        pkill -x --signal SIGUSR2 slurmctld >/dev/null 2>&1 || true
    endscript
}
{% else %}
{{ slurmddebug.log }} {
    weekly
    rotate 8
    maxsize 200M
    compress
    delaycompress
    missingok
    notifempty
    create 0600 root root
    postrotate
        pkill -x --signal SIGUSR2 slurmd >/dev/null 2>&1 || true
    endscript
}
{% endif %}
