[Unit]
Description=Slurm DBD accounting daemon
After=network-online.target remote-fs.target munge.service mariadb.service sssd.service
Wants=network-online.target
ConditionPathExists={{ slurm_dir }}/etc/slurmdbd.conf

# based on the unit shipped with Slurm 25.11, but started as root so it can read
# the root-owned slurmdbd.conf (mode 600); slurmdbd switches to SlurmUser itself
[Service]
Type=simple
EnvironmentFile=-/etc/sysconfig/slurmdbd
ExecStart={{ slurm_dir }}/sbin/slurmdbd -D -s $SLURMDBD_OPTIONS
ExecReload=/bin/kill -HUP $MAINPID
LimitNOFILE=65536
LimitMEMLOCK=infinity
TasksMax=infinity

[Install]
WantedBy=multi-user.target
