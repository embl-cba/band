# example: copy to files/etcHosts and put in the real addresses
127.0.0.1 localhost
::1     ip6-localhost ip6-loopback
fe00::0 ip6-localnet
ff00::0 ip6-mcastprefix
ff02::1 ip6-allnodes
ff02::2 ip6-allrouters
10.0.0.11 mgmt-0
10.0.0.12 login-0
10.0.0.13 node-1
10.0.0.14 node-2
10.0.0.15 node-3
10.0.0.16 node-4
10.0.0.17 node-5
10.0.0.18 node-6
10.0.0.19 node-7
10.0.0.20 node-8
10.0.0.21 band-portal
10.0.0.22 ldap.example.org ldap
# NFS server; it only exports to IPv6 clients (not over IPv4)
2001:db8::10 nfs-server
